# Your AWS / API credentials — copy .env.example to .env and fill it in. Never commit .env.
.env
# Deploy-only AWS keys, for lessons that deploy to AWS — kept apart from .env. Never commit.
.env.deploy

# Personal data: real CV/profile and generated applications. Commit cv/original_cv.example.md only.
cv/*
!cv/original_cv.example.md
output/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
# the install record pip leaves in 00-common/ (setup.sh installs it as a package)
*.egg-info/

# Virtualenv
.venv/
venv/

# Local vector DB stores the labs may create
chroma_db/
qdrant_storage/
qdrant_local/
*.faiss
faiss_index*/

# IDE / OS — but NOT .vscode/settings.json: each lesson ships one so walkthroughs
# open in rendered markdown preview.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
