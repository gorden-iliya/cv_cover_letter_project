# Copy to .env and fill in. Never commit .env. Variables are described in prd.md §7.

# AWS credentials (or use an AWS profile / SSO instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Required
BEDROCK_MODEL_ID=
AWS_REGION=
ALLOWED_JOB_SITES=jobs.lever.co,boards.greenhouse.io,comeet.com
MAX_TOKENS_PER_CALL=4096

# Optional (defaults shown)
MAX_VALIDATION_ROUNDS=2
CHROME_HEADLESS=false
CV_PATH=cv/original_cv.md
PROFILE_PATH=cv/profile.md
OUTPUT_DIR=output
